# python.env — where MyGPT's launcher scripts find Python.
#
# run.sh, updater.sh and updater.bat read this file. Set PYTHON to the
# interpreter they should use — an absolute path, or a path relative to this
# folder. If the path is missing/unreadable, the scripts fall back to
# auto-detection (project .venv, then python3 / python).
#
# The interpreter must have MyGPT's dependencies installed
# (pip install -r requirements.txt).
#
# Examples:
#   PYTHON=.venv/bin/python              Linux/macOS project venv (default)
#   PYTHON=.venv\Scripts\python.exe      Windows project venv
#   PYTHON=/usr/bin/python3              system interpreter
#   PYTHON=C:\Python312\python.exe       Windows absolute path
PYTHON=.venv/bin/python
